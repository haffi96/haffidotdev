{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haffi-mywebsite",
  "account_id": "7b90172cb4dfa9ecd9b6582bce068917",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-05-19",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "haffi.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    // PR previews: CI deploys one Worker per PR to pr-<N>.preview.haffi.dev.
    // Routes must stay empty so a preview can never claim haffi.dev.
    "preview": {
      "routes": [],
      "workers_dev": false
    }
  }
}
